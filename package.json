{
  "name": "absensi-sekolah",
  "version": "1.0.0",
  "description": "Sistem Absensi Sekolah Modern dengan Node.js Express, Baileys WhatsApp Gateway, RFID & QR Code Scanner, dan SQLite WAL",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/database/seed.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop absensi-sekolah",
    "pm2:restart": "pm2 restart absensi-sekolah",
    "pm2:logs": "pm2 logs absensi-sekolah",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "protobufjs": "^7.5.5",
    "form-data": "^4.0.1",
    "qs": "^6.13.0",
    "tough-cookie": "^4.1.3",
    "uuid": "^11.1.1"
  }
}

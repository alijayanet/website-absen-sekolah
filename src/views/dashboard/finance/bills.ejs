<%- include('../../partials/header', { title: pageTitle, isDashboard: true }) %>

<div class="flex h-screen overflow-hidden bg-slate-50">
  <%- include('../sidebar') %>

  <main class="flex-1 flex flex-col min-w-0 h-full overflow-y-auto">
    <!-- Header -->
    <header class="h-16 bg-white border-b border-slate-200 px-3.5 sm:px-6 flex items-center justify-between sticky top-0 z-20">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <button type="button" onclick="toggleSidebar()" class="md:hidden p-2 -ml-1 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition shrink-0">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <div class="min-w-0">
          <h1 class="text-sm sm:text-lg font-extrabold text-slate-900 leading-tight truncate">
            Kelola Tagihan & SPP Siswa
          </h1>
          <p class="text-[11px] sm:text-xs text-slate-500 font-medium hidden sm:block truncate">
            Daftar tagihan, QRIS Dinamis otomatis per nominal, dan pembayaran tunai
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button type="button" onclick="openCategoriesManagerModal()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold border border-indigo-200 transition">
          <i data-lucide="tags" class="w-3.5 h-3.5"></i>
          <span class="hidden sm:inline">Kelola Kategori</span>
          <span class="sm:hidden">Kategori</span>
        </button>
        <button type="button" onclick="openMonthlyModal()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700 text-xs font-semibold shadow-sm transition">
          <i data-lucide="calendar-plus" class="w-3.5 h-3.5"></i>
          <span class="hidden sm:inline">+ Terbitkan Tagihan Rutin</span>
          <span class="sm:hidden">+ Rutin</span>
        </button>
        <button type="button" onclick="openSingleModal()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold border border-slate-300 transition">
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          <span class="hidden sm:inline">+ Tagihan Khusus</span>
        </button>
      </div>
    </header>

    <div class="p-4 sm:p-6 max-w-7xl w-full mx-auto space-y-6">
      <!-- Flash Alert -->
      <% if (locals.success) { %>
        <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-3.5 flex items-center justify-between text-emerald-800 text-xs font-medium shadow-sm">
          <div class="flex items-center gap-2">
            <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
            <span><%= success %></span>
          </div>
        </div>
      <% } %>

      <% if (locals.error) { %>
        <div class="bg-rose-50 border border-rose-200 rounded-xl p-3.5 flex items-center justify-between text-rose-800 text-xs font-medium shadow-sm">
          <div class="flex items-center gap-2">
            <i data-lucide="alert-circle" class="w-4 h-4 text-rose-600"></i>
            <span><%= error %></span>
          </div>
        </div>
      <% } %>

      <!-- Filter Bar -->
      <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
        <form method="GET" action="/dashboard/finance/bills" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          <!-- Filter Status -->
          <div>
            <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Status Pembayaran</label>
            <select name="status" onchange="this.form.submit()" class="w-full text-xs border border-slate-300 rounded-lg px-2.5 py-1.5 bg-slate-50 text-slate-700">
              <option value="all" <%= !filters.status || filters.status === 'all' ? 'selected' : '' %>>Semua Status</option>
              <option value="UNPAID" <%= filters.status === 'UNPAID' ? 'selected' : '' %>>Belum Lunas (UNPAID)</option>
              <option value="PAID" <%= filters.status === 'PAID' ? 'selected' : '' %>>Lunas (PAID)</option>
              <option value="CANCELLED" <%= filters.status === 'CANCELLED' ? 'selected' : '' %>>Dibatalkan</option>
            </select>
          </div>

          <!-- Filter Kelas -->
          <div>
            <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Rombel / Kelas</label>
            <select name="class_id" onchange="this.form.submit()" class="w-full text-xs border border-slate-300 rounded-lg px-2.5 py-1.5 bg-slate-50 text-slate-700">
              <option value="all" <%= !filters.class_id || filters.class_id === 'all' ? 'selected' : '' %>>Semua Kelas</option>
              <% classes.forEach(c => { %>
                <option value="<%= c.id %>" <%= String(filters.class_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
          </div>

          <!-- Filter Kategori -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider">Kategori Biaya</label>
              <button type="button" onclick="openCategoriesManagerModal()" class="text-[10px] text-blue-600 font-bold hover:underline">
                + Kelola
              </button>
            </div>
            <select name="category_id" onchange="this.form.submit()" class="w-full text-xs border border-slate-300 rounded-lg px-2.5 py-1.5 bg-slate-50 text-slate-700">
              <option value="all" <%= !filters.category_id || filters.category_id === 'all' ? 'selected' : '' %>>Semua Kategori</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= String(filters.category_id) === String(cat.id) ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>
          </div>

          <!-- Filter Bulan Periode -->
          <div>
            <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Periode Bulan</label>
            <input type="month" name="period" value="<%= filters.period || '' %>" onchange="this.form.submit()" class="w-full text-xs border border-slate-300 rounded-lg px-2.5 py-1.5 bg-slate-50 text-slate-700">
          </div>

          <!-- Pencarian Siswa -->
          <div>
            <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Cari Nama / NIS</label>
            <div class="relative">
              <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Ketik kata kunci..." class="w-full text-xs border border-slate-300 rounded-lg pl-8 pr-2.5 py-1.5 bg-slate-50 text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
              <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5"></i>
            </div>
          </div>
        </form>
      </div>

      <!-- Tabel Daftar Tagihan -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
          <h2 class="text-xs font-bold text-slate-700">Menampilkan <%= bills.length %> data tagihan</h2>
          <span class="text-[11px] text-slate-400">Kode unik 3 digit otomatis disisipkan untuk verifikasi webhook QRIS</span>
        </div>

        <% if (bills.length === 0) { %>
          <div class="text-center py-16 text-slate-400">
            <i data-lucide="receipt" class="w-12 h-12 mx-auto stroke-1 mb-2 text-slate-300"></i>
            <p class="text-sm font-semibold text-slate-600">Tidak ada data tagihan yang sesuai filter</p>
            <p class="text-xs mt-1">Silakan sesuaikan filter pencarian atau klik "+ Terbitkan SPP Bulanan".</p>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 text-slate-600 uppercase text-[10px] tracking-wider border-b border-slate-200">
                <tr>
                  <th class="py-3 px-3.5">No. Invoice</th>
                  <th class="py-3 px-3.5">Siswa & Rombel</th>
                  <th class="py-3 px-3.5">Tagihan & Periode</th>
                  <th class="py-3 px-3.5 text-right">Tarif Dasar</th>
                  <th class="py-3 px-3.5 text-center">Kode Unik</th>
                  <th class="py-3 px-3.5 text-right">Total Bayar</th>
                  <th class="py-3 px-3.5 text-center">Status</th>
                  <th class="py-3 px-3.5 text-center">Aksi / Pembayaran</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-700">
                <% bills.forEach(b => { %>
                  <tr class="hover:bg-slate-50/70 transition">
                    <td class="py-3 px-3.5 font-mono font-semibold text-blue-600 whitespace-nowrap">
                      <%= b.bill_code %>
                      <div class="text-[10px] text-slate-400 font-normal">
                        <%= new Date(b.created_at).toLocaleDateString('id-ID') %>
                      </div>
                    </td>
                    <td class="py-3 px-3.5">
                      <p class="font-bold text-slate-900"><%= b.student_name %></p>
                      <p class="text-[11px] text-slate-500">NIS: <%= b.nis %> • <%= b.class_name || '-' %></p>
                      <% if (b.parent_phone) { %>
                        <p class="text-[10px] text-slate-400 font-mono">WA: <%= b.parent_phone %></p>
                      <% } %>
                    </td>
                    <td class="py-3 px-3.5">
                      <p class="font-semibold text-slate-800"><%= b.title %></p>
                      <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600">
                        <%= b.category_name %> <%= b.period ? `(${b.period})` : '' %>
                      </span>
                    </td>
                    <td class="py-3 px-3.5 text-right font-mono text-slate-600">
                      <%= formatRupiah(b.base_amount) %>
                    </td>
                    <td class="py-3 px-3.5 text-center font-mono">
                      <% if (b.unique_code) { %>
                        <span class="inline-block px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 font-bold text-[11px] border border-amber-200">
                          +<%= b.unique_code %>
                        </span>
                      <% } else { %>
                        <span class="text-slate-400">-</span>
                      <% } %>
                    </td>
                    <td class="py-3 px-3.5 text-right font-mono font-bold text-slate-900 whitespace-nowrap">
                      <%= formatRupiah(b.total_amount) %>
                    </td>
                    <td class="py-3 px-3.5 text-center whitespace-nowrap">
                      <% if (b.status === 'PAID') { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                          <i data-lucide="check-circle" class="w-3 h-3"></i> Lunas
                        </span>
                        <% if (b.paid_at) { %>
                          <div class="text-[9px] text-slate-400 mt-0.5">
                            <%= new Date(b.paid_at).toLocaleDateString('id-ID') %>
                          </div>
                        <% } %>
                      <% } else if (b.status === 'UNPAID') { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                          <i data-lucide="clock" class="w-3 h-3"></i> Belum Lunas
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-100 text-slate-500">
                          Dibatalkan
                        </span>
                      <% } %>
                    </td>
                    <td class="py-3 px-3.5 text-center whitespace-nowrap">
                      <div class="flex items-center justify-center gap-1.5">
                        <% if (b.status === 'UNPAID') { %>
                          <!-- Tombol Dynamic QRIS Modal -->
                          <button type="button" onclick="showQrisModal(<%= b.id %>)" class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold border border-indigo-200 transition" title="Tampilkan QRIS Dinamis">
                            <i data-lucide="qr-code" class="w-3.5 h-3.5"></i>
                            <span>QRIS</span>
                          </button>

                          <!-- Tombol Bayar Tunai Kasir TU -->
                          <button type="button" onclick="openCashPayModal(<%= b.id %>, '<%= b.bill_code %>', '<%= b.student_name.replace(/'/g, '\\\'') %>', <%= b.total_amount %>)" class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold border border-emerald-200 transition" title="Bayar Tunai di Kasir TU">
                            <i data-lucide="banknote" class="w-3.5 h-3.5"></i>
                            <span>Bayar Kasir</span>
                          </button>

                          <!-- Edit Tagihan -->
                          <button type="button" onclick="openEditModal(<%= b.id %>, '<%= b.title.replace(/'/g, '\\\'') %>', <%= b.base_amount %>, '<%= b.due_date || '' %>', '<%= (b.notes || '').replace(/'/g, '\\\'') %>')" class="p-1 rounded text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition" title="Edit Tagihan">
                            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                          </button>

                          <!-- Batalkan Tagihan -->
                          <form method="POST" action="/dashboard/finance/bills/<%= b.id %>/cancel" onsubmit="return confirm('Apakah Anda yakin ingin membatalkan tagihan ini?')" class="inline">
                            <button type="submit" class="p-1 rounded text-slate-400 hover:text-rose-600 hover:bg-slate-100 transition" title="Batalkan Tagihan">
                              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                          </form>
                        <% } else if (b.status === 'PAID') { %>
                          <!-- Cetak Kuitansi -->
                          <a href="/dashboard/finance/bills/<%= b.id %>/receipt" target="_blank" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold border border-blue-200 transition">
                            <i data-lucide="printer" class="w-3.5 h-3.5"></i>
                            <span>Kuitansi</span>
                          </a>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<!-- MODAL: Terbitkan Tagihan Rutin Massal (Bulanan & Mingguan) -->
<div id="monthlyModal" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
        <i data-lucide="calendar-plus" class="w-4 h-4 text-blue-600"></i>
        <span>Terbitkan Tagihan Rutin Massal</span>
      </h3>
      <button type="button" onclick="closeMonthlyModal()" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form method="POST" action="/dashboard/finance/bills/generate-monthly" class="space-y-3.5">
      <input type="hidden" name="period" id="bulkFinalPeriod" value="<%= currentPeriod %>">
      <input type="hidden" name="title" id="bulkTitleInput" value="">

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block text-xs font-semibold text-slate-700">Kategori Tagihan</label>
          <button type="button" onclick="openCategoriesManagerModal()" class="text-[10px] text-blue-600 font-bold hover:underline">+ Kelola / Tambah</button>
        </div>
        <select name="category_id" id="monthlyCatSelect" onchange="handleBulkCategoryChange()" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" 
                    data-amount="<%= cat.default_amount %>" 
                    data-frequency="<%= cat.frequency || (cat.is_monthly == 1 ? 'MONTHLY' : (cat.is_monthly == 2 ? 'WEEKLY' : 'ONCE')) %>"
                    <%= cat.code === 'SPP' ? 'selected' : '' %>>
              <%= cat.name %> (<%= cat.frequency === 'WEEKLY' || cat.is_monthly == 2 ? 'Mingguan' : (cat.frequency === 'MONTHLY' || cat.is_monthly == 1 ? 'Bulanan' : 'Sekali Bayar') %> • <%= formatRupiah(cat.default_amount) %>)
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Container Periode Bulanan -->
      <div id="bulkMonthlyPeriodContainer">
        <label class="block text-xs font-semibold text-slate-700 mb-1">Periode Bulan Tagihan</label>
        <input type="month" id="bulkMonthInput" value="<%= currentPeriod %>" onchange="syncBulkPeriod()" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none font-semibold">
      </div>

      <!-- Container Periode Mingguan (Pekan) -->
      <div id="bulkWeeklyPeriodContainer" class="hidden space-y-1.5">
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Bulan Periode</label>
            <input type="month" id="bulkWeekMonthInput" value="<%= currentPeriod %>" onchange="syncBulkPeriod()" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none font-semibold">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Pekan / Minggu Ke</label>
            <select id="bulkWeekSelect" onchange="syncBulkPeriod()" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none font-semibold">
              <option value="1">Minggu ke-1</option>
              <option value="2">Minggu ke-2</option>
              <option value="3">Minggu ke-3</option>
              <option value="4">Minggu ke-4</option>
              <option value="5">Minggu ke-5</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Preview Judul Tagihan yang Dihasilkan -->
      <div class="p-2.5 rounded-xl bg-blue-50/60 border border-blue-100 flex items-center justify-between text-xs">
        <span class="text-[11px] text-slate-500 font-medium">Judul Tagihan:</span>
        <span class="font-bold text-blue-700 text-xs truncate max-w-[200px]" id="bulkTitleText">-</span>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Pilih Rombel / Kelas Target</label>
        <select name="class_id" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <option value="all">Semua Rombel / Seluruh Siswa Aktif</option>
          <% classes.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Tarif Tagihan Dasar (Rp)</label>
        <input type="number" name="base_amount" id="monthlyBaseAmount" required value="150000" min="1000" step="1000" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none">
        <p class="text-[10px] text-slate-400 mt-1">Kode unik 3 digit acak otomatis disematkan pada tiap siswa agar nominal transfer berbeda.</p>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Jatuh Tempo (Opsional)</label>
        <input type="date" name="due_date" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>

      <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeMonthlyModal()" class="px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100 rounded-lg font-semibold">Batal</button>
        <button type="submit" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow-sm">Terbitkan Tagihan Massal</button>
      </div>
    </form>
  </div>
</div>

<!-- MODAL: Tagihan Khusus / Satuan -->
<div id="singleModal" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
        <i data-lucide="plus-circle" class="w-4 h-4 text-blue-600"></i>
        <span>Buat Tagihan Khusus Siswa</span>
      </h3>
      <button type="button" onclick="closeSingleModal()" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form method="POST" action="/dashboard/finance/bills/create-single" class="space-y-3.5">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Pilih Siswa</label>
        <select name="student_id" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <% students.forEach(s => { %>
            <option value="<%= s.id %>"><%= s.name %> (NIS: <%= s.nis %> • <%= s.class_name || '-' %>)</option>
          <% }) %>
        </select>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block text-xs font-semibold text-slate-700">Kategori Biaya</label>
          <button type="button" onclick="openCategoriesManagerModal()" class="text-[10px] text-blue-600 font-bold hover:underline">+ Kelola / Tambah</button>
        </div>
        <select name="category_id" id="singleCatSelect" onchange="updateSingleAmount()" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" data-amount="<%= cat.default_amount %>" data-frequency="<%= cat.frequency || (cat.is_monthly == 1 ? 'MONTHLY' : (cat.is_monthly == 2 ? 'WEEKLY' : 'ONCE')) %>">
              <%= cat.name %> (<%= cat.frequency === 'WEEKLY' || cat.is_monthly == 2 ? 'Mingguan' : (cat.frequency === 'MONTHLY' || cat.is_monthly == 1 ? 'Bulanan' : 'Sekali Bayar') %> • <%= formatRupiah(cat.default_amount) %>)
            </option>
          <% }) %>
        </select>
      </div>

      <div>

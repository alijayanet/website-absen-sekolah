<!-- MODAL: Kelola Kategori Tagihan (CRUD) -->
<div id="categoriesManagerModal" onclick="if(event.target === this) closeCategoriesManagerModal()" class="fixed inset-0 z-[60] hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-100 space-y-5 max-h-[90vh] flex flex-col">
    <!-- Modal Header -->
    <div class="flex items-center justify-between border-b border-slate-100 pb-3 shrink-0">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center">
          <i data-lucide="tags" class="w-4 h-4"></i>
        </div>
        <div>
          <h3 class="text-sm font-bold text-slate-900">Kelola Kategori Tagihan & Biaya</h3>
          <p class="text-[11px] text-slate-500">Tambah, ubah tarif standar, dan hapus kategori tagihan sekolah</p>
        </div>
      </div>
      <button type="button" onclick="closeCategoriesManagerModal()" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <!-- Scrollable Content -->
    <div class="space-y-4 overflow-y-auto pr-1 flex-1">
      <!-- Form Tambah / Edit Kategori -->
      <div class="p-4 rounded-xl border border-indigo-100 bg-indigo-50/40 space-y-3">
        <div class="flex items-center justify-between">
          <h4 id="crudFormTitle" class="text-xs font-bold text-indigo-950 flex items-center gap-1.5">
            <i data-lucide="plus-circle" class="w-3.5 h-3.5 text-indigo-600"></i>
            <span>Tambah Kategori Baru</span>
          </h4>
          <span class="text-[10px] text-slate-500 font-medium">* Tarif standar dapat diubah kembali saat pembuatan tagihan</span>
        </div>

        <form id="categoryCrudForm" method="POST" action="/dashboard/finance/categories/save" class="space-y-3">
          <input type="hidden" id="crudCatId" name="id" value="">
          <input type="hidden" name="return_to" value="/dashboard/finance/bills">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Kode Unik Kategori</label>
              <input type="text" id="crudCatCode" name="code" required placeholder="CONTOH: SPP, GEDUNG, UJIAN" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 uppercase font-mono bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Nama Kategori Biaya</label>
              <input type="text" id="crudCatName" name="name" required placeholder="Contoh: SPP Bulanan, Uang Gedung" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-center">
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Tarif Standar (Rp)</label>
              <input type="number" id="crudCatAmount" name="default_amount" required placeholder="150000" min="0" step="1000" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 font-mono bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Tipe Frekuensi Tagihan</label>
              <select id="crudCatFrequency" name="frequency" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none font-medium">
                <option value="MONTHLY">📅 Bulanan (Tagihan rutin per bulan, misal: SPP)</option>
                <option value="WEEKLY">📆 Mingguan (Tagihan rutin per pekan, misal: Uang Kas, Infaq)</option>
                <option value="ONCE">🏷️ Sekali Bayar (Non-rutin, misal: Uang Gedung, Seragam)</option>
              </select>
            </div>
          </div>

          <div class="flex items-center justify-end gap-2 pt-2 border-t border-indigo-100">
            <button type="button" id="crudCancelEditBtn" onclick="resetCategoryForm()" class="hidden px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-200 rounded-lg font-semibold transition">
              Batal Edit
            </button>
            <button type="submit" id="crudSubmitBtn" class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg shadow-sm transition flex items-center gap-1.5">
              <i data-lucide="check" class="w-3.5 h-3.5"></i>
              <span>Simpan Kategori</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Tabel Daftar Kategori Tagihan yang Ada -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <h4 class="text-xs font-bold text-slate-800">Daftar Kategori Aktif (<%= categories.length %>)</h4>
          <span class="text-[10px] text-slate-400">Klik tombol edit atau hapus pada baris kategori</span>
        </div>

        <div class="overflow-x-auto border border-slate-200 rounded-xl">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-600 uppercase text-[10px] tracking-wider border-b border-slate-200">
              <tr>
                <th class="py-2.5 px-3">Kode</th>
                <th class="py-2.5 px-3">Nama Kategori</th>
                <th class="py-2.5 px-3 text-right">Tarif Standar</th>
                <th class="py-2.5 px-3 text-center">Tipe Tagihan</th>
                <th class="py-2.5 px-3 text-center">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <% categories.forEach(cat => { %>
                <tr class="hover:bg-slate-50/70 transition">
                  <td class="py-2.5 px-3 font-mono font-bold text-blue-600">
                    <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-mono text-[10px] border border-blue-200">
                      <%= cat.code %>
                    </span>
                  </td>
                  <td class="py-2.5 px-3 font-semibold text-slate-900">
                    <%= cat.name %>
                  </td>
                  <td class="py-2.5 px-3 text-right font-mono font-bold text-slate-800">
                    <%= formatRupiah(cat.default_amount) %>
                  </td>
                  <td class="py-2.5 px-3 text-center">
                    <% if (cat.frequency === 'WEEKLY' || cat.is_monthly === 2) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                        Mingguan
                      </span>
                    <% } else if (cat.frequency === 'MONTHLY' || cat.is_monthly === 1) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-100 text-indigo-700 border border-indigo-200">
                        Bulanan
                      </span>
                    <% } else { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200">
                        Sekali Bayar
                      </span>
                    <% } %>
                  </td>
                  <td class="py-2.5 px-3 text-center">
                    <div class="flex items-center justify-center gap-1.5">
                      <!-- Tombol Edit -->
                      <button 
                        type="button" 
                        data-id="<%= cat.id %>"
                        data-code="<%= cat.code %>"
                        data-name="<%= cat.name %>"
                        data-amount="<%= cat.default_amount %>"
                        data-frequency="<%= cat.frequency || (cat.is_monthly == 1 ? 'MONTHLY' : (cat.is_monthly == 2 ? 'WEEKLY' : 'ONCE')) %>"
                        data-monthly="<%= cat.is_monthly %>"
                        onclick="editCategoryFromBtn(this)" 
                        class="p-1.5 rounded-lg text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 border border-slate-200 hover:border-indigo-200 transition" 
                        title="Edit Kategori"
                      >
                        <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                      </button>

                      <!-- Tombol Hapus -->
                      <form method="POST" action="/dashboard/finance/categories/<%= cat.id %>/delete" onsubmit="return confirm('Apakah Anda yakin ingin menghapus kategori tagihan <%= cat.name.replace(/'/g, '\\\'') %>?')" class="inline">
                        <input type="hidden" name="return_to" value="/dashboard/finance/bills">
                        <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 border border-slate-200 hover:border-rose-200 transition" title="Hapus Kategori">
                          <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="pt-3 border-t border-slate-100 flex justify-end shrink-0">
      <button type="button" onclick="closeCategoriesManagerModal()" class="px-4 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition">
        Tutup
      </button>
    </div>
  </div>
</div>

<script>
  function openCategoriesManagerModal() {
    resetCategoryForm();
    const modal = document.getElementById('categoriesManagerModal');
    if (modal) {
      modal.classList.remove('hidden');
    }
    if (window.lucide) window.lucide.createIcons();
  }

  function closeCategoriesManagerModal() {
    const modal = document.getElementById('categoriesManagerModal');
    if (modal) {
      modal.classList.add('hidden');
    }
    resetCategoryForm();
  }

  function editCategoryFromBtn(btn) {
    const id = btn.getAttribute('data-id');
    const code = btn.getAttribute('data-code');
    const name = btn.getAttribute('data-name');
    const defaultAmount = btn.getAttribute('data-amount');
    const frequency = btn.getAttribute('data-frequency') || (btn.getAttribute('data-monthly') == '1' ? 'MONTHLY' : (btn.getAttribute('data-monthly') == '2' ? 'WEEKLY' : 'ONCE'));
    editCategoryItem(id, code, name, defaultAmount, frequency);
  }

  function editCategoryItem(id, code, name, defaultAmount, frequency) {
    const idEl = document.getElementById('crudCatId');
    if (idEl) idEl.value = id;
    const codeEl = document.getElementById('crudCatCode');
    if (codeEl) codeEl.value = code;
    const nameEl = document.getElementById('crudCatName');
    if (nameEl) nameEl.value = name;
    const amtEl = document.getElementById('crudCatAmount');
    if (amtEl) amtEl.value = defaultAmount;
    const freqEl = document.getElementById('crudCatFrequency');
    if (freqEl) freqEl.value = frequency || 'ONCE';

    const titleEl = document.getElementById('crudFormTitle');
    if (titleEl) {
      titleEl.innerHTML = '<i data-lucide="edit-3" class="w-3.5 h-3.5 text-indigo-600"></i><span>Edit Kategori: ' + name + '</span>';
    }
    const submitEl = document.getElementById('crudSubmitBtn');
    if (submitEl) {
      submitEl.innerHTML = '<i data-lucide="save" class="w-3.5 h-3.5"></i><span>Simpan Perubahan</span>';
    }
    const cancelEl = document.getElementById('crudCancelEditBtn');
    if (cancelEl) cancelEl.classList.remove('hidden');

    if (window.lucide) window.lucide.createIcons();
    if (nameEl) nameEl.focus();
  }

  function resetCategoryForm() {
    const idEl = document.getElementById('crudCatId');
    if (idEl) idEl.value = '';
    const codeEl = document.getElementById('crudCatCode');
    if (codeEl) codeEl.value = '';
    const nameEl = document.getElementById('crudCatName');
    if (nameEl) nameEl.value = '';
    const amtEl = document.getElementById('crudCatAmount');
    if (amtEl) amtEl.value = '';
    const freqEl = document.getElementById('crudCatFrequency');
    if (freqEl) freqEl.value = 'MONTHLY';

    const titleEl = document.getElementById('crudFormTitle');
    if (titleEl) {
      titleEl.innerHTML = '<i data-lucide="plus-circle" class="w-3.5 h-3.5 text-indigo-600"></i><span>Tambah Kategori Baru</span>';
    }
    const submitEl = document.getElementById('crudSubmitBtn');
    if (submitEl) {
      submitEl.innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5"></i><span>Simpan Kategori</span>';
    }
    const cancelEl = document.getElementById('crudCancelEditBtn');
    if (cancelEl) cancelEl.classList.add('hidden');

    if (window.lucide) window.lucide.createIcons();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('manage_categories') === '1' || window.location.hash === '#categories') {
      openCategoriesManagerModal();
    }
  });

  function openMonthlyModal() {
    handleBulkCategoryChange();
    document.getElementById('monthlyModal').classList.remove('hidden');
    if (window.lucide) window.lucide.createIcons();
  }

  function closeMonthlyModal() {
    document.getElementById('monthlyModal').classList.add('hidden');
  }

  function handleBulkCategoryChange() {
    const select = document.getElementById('monthlyCatSelect');
    if (!select) return;
    const selectedOption = select.options[select.selectedIndex];
    if (!selectedOption) return;

    const amount = selectedOption.getAttribute('data-amount');
    if (amount) {
      document.getElementById('monthlyBaseAmount').value = amount;
    }

    const frequency = selectedOption.getAttribute('data-frequency');
    const monthlyContainer = document.getElementById('bulkMonthlyPeriodContainer');
    const weeklyContainer = document.getElementById('bulkWeeklyPeriodContainer');

    if (frequency === 'WEEKLY') {
      if (monthlyContainer) monthlyContainer.classList.add('hidden');
      if (weeklyContainer) weeklyContainer.classList.remove('hidden');
    } else {
      if (monthlyContainer) monthlyContainer.classList.remove('hidden');
      if (weeklyContainer) weeklyContainer.classList.add('hidden');
    }

    syncBulkPeriod();
  }

  function syncBulkPeriod() {
    const select = document.getElementById('monthlyCatSelect');
    const selectedOption = select ? select.options[select.selectedIndex] : null;
    const catName = selectedOption ? selectedOption.text.split('(')[0].trim() : 'Tagihan';
    const frequency = selectedOption ? selectedOption.getAttribute('data-frequency') : 'MONTHLY';

    const monthNames = [
      'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
      'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
    ];

    let finalPeriod = '';
    let previewTitle = '';

    if (frequency === 'WEEKLY') {
      const monthInput = document.getElementById('bulkWeekMonthInput');
      const weekSelect = document.getElementById('bulkWeekSelect');
      const monthVal = (monthInput && monthInput.value) || '<%= currentPeriod %>';
      const weekVal = (weekSelect && weekSelect.value) || '1';
      finalPeriod = `${monthVal}-W${weekVal}`;

      const [yr, mo] = monthVal.split('-');
      const mName = monthNames[parseInt(mo, 10) - 1] || mo;
      previewTitle = `${catName} - Minggu ke-${weekVal} ${mName} ${yr}`;
    } else {
      const monthInput = document.getElementById('bulkMonthInput');
      const monthVal = (monthInput && monthInput.value) || '<%= currentPeriod %>';
      finalPeriod = monthVal;

      const [yr, mo] = monthVal.split('-');
      const mName = monthNames[parseInt(mo, 10) - 1] || mo;
      previewTitle = `${catName} - ${mName} ${yr}`;
    }

    const finalPeriodInput = document.getElementById('bulkFinalPeriod');
    if (finalPeriodInput) finalPeriodInput.value = finalPeriod;

    const titleTextInput = document.getElementById('bulkTitleText');
    if (titleTextInput) titleTextInput.textContent = previewTitle;

    const hiddenTitleInput = document.getElementById('bulkTitleInput');
    if (hiddenTitleInput) hiddenTitleInput.value = previewTitle;
  }

  function openSingleModal() {
    updateSingleAmount();
    document.getElementById('singleModal').classList.remove('hidden');
  }
  function closeSingleModal() {
    document.getElementById('singleModal').classList.add('hidden');
  }

  function updateSingleAmount() {
    const select = document.getElementById('singleCatSelect');
    const selectedOption = select.options[select.selectedIndex];
    const amount = selectedOption.getAttribute('data-amount');
    if (amount) {
      document.getElementById('singleBaseAmount').value = amount;
    }
  }

  function openCashPayModal(billId, billCode, studentName, amount) {
    document.getElementById('cashPayForm').action = `/dashboard/finance/bills/${billId}/pay-cash`;
    document.getElementById('cashBillCode').textContent = billCode;
    document.getElementById('cashStudentName').textContent = studentName;
    document.getElementById('cashAmount').textContent = 'Rp ' + Number(amount).toLocaleString('id-ID');
    document.getElementById('cashModal').classList.remove('hidden');
  }
  function closeCashPayModal() {
    document.getElementById('cashModal').classList.add('hidden');
  }

  function openEditModal(billId, title, baseAmount, dueDate, notes) {
    document.getElementById('editForm').action = `/dashboard/finance/bills/${billId}/update`;
    document.getElementById('editTitle').value = title;
    document.getElementById('editBaseAmount').value = baseAmount;
    document.getElementById('editDueDate').value = dueDate;
    document.getElementById('editNotes').value = notes;
    document.getElementById('editModal').classList.remove('hidden');
  }
  function closeEditModal() {
    document.getElementById('editModal').classList.add('hidden');
  }

  async function showQrisModal(billId) {
    const modal = document.getElementById('qrisModal');
    const loading = document.getElementById('qrisLoading');
    const content = document.getElementById('qrisContent');
    
    modal.classList.remove('hidden');
    loading.classList.remove('hidden');
    content.classList.add('hidden');

    try {
      const res = await fetch(`/dashboard/finance/bills/${billId}/qris-json`);
      const data = await res.json();

      if (!data.success) {
        alert(data.error || 'Gagal membuat QRIS');
        modal.classList.add('hidden');
        return;
      }

      document.getElementById('qrisImage').src = data.dataUrl;
      document.getElementById('qrisStudentName').textContent = data.bill.student_name + ' (' + (data.bill.class_name || '-') + ')';
      document.getElementById('qrisBillTitle').textContent = data.bill.title;
      document.getElementById('qrisTotalDisplay').textContent = 'Rp ' + Number(data.amount).toLocaleString('id-ID');
      document.getElementById('qrisUniqueBadge').textContent = 'Kode: ' + (data.bill.unique_code || 0);

      loading.classList.add('hidden');
      content.classList.remove('hidden');
    } catch (err) {
      alert('Error fetching QRIS: ' + err.message);
      modal.classList.add('hidden');
    }
  }
  function closeQrisModal() {
    document.getElementById('qrisModal').classList.add('hidden');
  }
</script>


<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kuitansi Pembayaran - <%= receipt ? receipt.receipt_no : bill.bill_code %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; padding: 0 !important; }
      .print-shadow { box-shadow: none !important; border: 1px solid #e2e8f0 !important; }
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen py-8 px-4 flex flex-col items-center font-sans antialiased text-slate-800">

  <!-- Action Bar (Hidden on Print) -->
  <div class="no-print max-w-xl w-full mb-4 flex items-center justify-between">
    <a href="/dashboard/finance/bills" class="text-xs font-semibold text-slate-600 hover:text-slate-900 flex items-center gap-1.5">
      &larr; Kembali ke Daftar Tagihan
    </a>
    <button onclick="window.print()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold shadow transition flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
      Cetak / Simpan PDF
    </button>
  </div>

  <!-- Kuitansi Container -->
  <div class="bg-white rounded-2xl border border-slate-200 p-8 max-w-xl w-full shadow-lg print-shadow relative overflow-hidden">
    
    <!-- Watermark Lunas -->
    <div class="absolute right-4 top-24 pointer-events-none opacity-10 rotate-[-20deg] select-none">
      <div class="border-8 border-emerald-600 text-emerald-600 font-extrabold text-7xl px-8 py-2 rounded-2xl uppercase tracking-widest">
        LUNAS
      </div>
    </div>

    <!-- Kop Sekolah -->
    <div class="flex items-center gap-4 pb-6 border-b-2 border-slate-900">
      <% if (settings.school_logo) { %>
        <img src="<%= settings.school_logo %>" alt="Logo" class="w-16 h-16 object-contain rounded">
      <% } else { %>
        <div class="w-16 h-16 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-2xl">
          <%= (settings.school_name || 'S').charAt(0) %>
        </div>
      <% } %>
      <div class="flex-1 min-w-0">
        <h1 class="text-lg font-black text-slate-900 uppercase tracking-tight"><%= settings.school_name || 'SMK TELADAN JAKARTA' %></h1>
        <p class="text-xs text-slate-500 leading-tight"><%= settings.school_address || 'Jl. Pendidikan No. 123' %></p>
        <p class="text-[11px] text-slate-400 mt-0.5 font-medium">
          Telp/WA: <%= settings.school_phone || '-' %> • Email: <%= settings.school_email || '-' %>
        </p>
      </div>
    </div>

    <!-- Judul Dokumen -->
    <div class="text-center my-6">
      <h2 class="text-base font-extrabold text-slate-900 tracking-wider uppercase underline underline-offset-4">
        BUKTI PEMBAYARAN KUITANSI
      </h2>
      <p class="text-xs font-mono font-bold text-blue-600 mt-1">
        <%= receipt ? receipt.receipt_no : 'TANDA TERIMA' %>
      </p>
    </div>

    <!-- Data Pembayaran & Siswa -->
    <div class="grid grid-cols-2 gap-y-2.5 text-xs text-slate-600 pb-6 border-b border-slate-100">
      <div>
        <span class="text-[11px] text-slate-400 block uppercase font-bold tracking-wider">Telah Diterima Dari:</span>
        <span class="font-bold text-slate-900 text-sm"><%= bill.student_name %></span>
      </div>
      <div>
        <span class="text-[11px] text-slate-400 block uppercase font-bold tracking-wider">Tanggal Bayar:</span>
        <span class="font-semibold text-slate-900">
          <%= receipt ? new Date(receipt.created_at).toLocaleString('id-ID', { dateStyle: 'long', timeStyle: 'short' }) : '-' %>
        </span>
      </div>
      <div>
        <span class="text-[11px] text-slate-400 block uppercase font-bold tracking-wider">NIS / NISN:</span>
        <span class="font-mono text-slate-800"><%= bill.nis %> / <%= bill.nisn || '-' %></span>
      </div>
      <div>
        <span class="text-[11px] text-slate-400 block uppercase font-bold tracking-wider">Kelas / Rombel:</span>
        <span class="font-semibold text-slate-800"><%= bill.class_name || '-' %></span>
      </div>
      <div>
        <span class="text-[11px] text-slate-400 block uppercase font-bold tracking-wider">No. Tagihan / Ref:</span>
        <span class="font-mono text-slate-800"><%= bill.bill_code %></span>
      </div>
      <div>
        <span class="text-[11px] text-slate-400 block uppercase font-bold tracking-wider">Metode Pembayaran:</span>
        <span class="font-bold text-slate-900"><%= receipt ? `${receipt.payment_method} (${receipt.payment_channel || 'Lunas'})` : 'Lunas' %></span>
      </div>
    </div>

    <!-- Rincian Biaya -->
    <div class="my-6">
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b border-slate-200 text-slate-400 text-[10px] uppercase font-bold">
            <th class="py-2 text-left">Deskripsi Tagihan</th>
            <th class="py-2 text-right">Nominal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr>
            <td class="py-3 text-slate-800 font-semibold">
              <%= bill.title %>
              <% if (bill.period) { %>
                <span class="text-slate-400 font-normal block text-[11px]">Periode: <%= bill.period %></span>
              <% } %>
            </td>
            <td class="py-3 text-right font-mono font-medium text-slate-800">
              <%= formatRupiah(bill.base_amount) %>
            </td>
          </tr>
          <% if (bill.unique_code > 0) { %>
            <tr>
              <td class="py-2 text-slate-500 text-[11px]">
                Kode Unik Verifikasi Sistem (Otomatis)
              </td>
              <td class="py-2 text-right font-mono text-slate-600 text-[11px]">
                +<%= bill.unique_code %>
              </td>
            </tr>
          <% } %>
        </tbody>
        <tfoot>
          <tr class="border-t-2 border-slate-900 font-bold text-slate-900">
            <td class="pt-3 text-sm">TOTAL PEMBAYARAN LUNAS</td>
            <td class="pt-3 text-right text-base font-mono text-emerald-600">
              <%= formatRupiah(receipt ? receipt.amount_paid : bill.total_amount) %>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Catatan & Tanda Tangan -->
    <div class="grid grid-cols-2 gap-4 text-xs pt-4 border-t border-slate-100">
      <div class="text-[11px] text-slate-500 leading-relaxed">
        <p class="font-bold text-slate-700">Catatan:</p>
        <p>1. Bukti pembayaran ini sah dan diterbitkan secara digital oleh sistem keuangan sekolah.</p>
        <p>2. Simpan tanda terima ini sebagai bukti pembayaran resmi.</p>
      </div>
      <div class="text-center">
        <p class="text-[11px] text-slate-500"><%= settings.school_address ? settings.school_address.split(',')[0] : 'Jakarta' %>, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        <p class="text-[11px] font-bold text-slate-700 mt-1">Petugas / Kasir TU,</p>
        <div class="h-16 flex items-center justify-center">
          <span class="px-3 py-1 rounded border border-emerald-500 text-emerald-600 font-bold text-[10px] tracking-wider uppercase">
            TERVERIFIKASI SISTEM
          </span>
        </div>
        <p class="font-bold text-slate-900 underline"><%= receipt ? receipt.received_by : 'Kasir TU' %></p>
      </div>
    </div>

  </div>

</body>
</html>

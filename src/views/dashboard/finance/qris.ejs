<%- include('../../partials/header', { title: pageTitle, isDashboard: true }) %>

<!-- jsQR Library untuk Pemindaian Barcode QRIS Client-Side Berkecepatan Tinggi -->
<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>

<div class="flex h-screen overflow-hidden bg-slate-50">
  <%- include('../sidebar') %>

  <main class="flex-1 flex flex-col min-w-0 h-full overflow-y-auto">
    <!-- Header -->
    <header class="h-16 bg-white border-b border-slate-200 px-3.5 sm:px-6 flex items-center justify-between sticky top-0 z-20">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <button type="button" onclick="toggleSidebar()" class="md:hidden p-2 -ml-1 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition shrink-0">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <div class="min-w-0">
          <h1 class="text-sm sm:text-lg font-extrabold text-slate-900 leading-tight truncate">
            Pengaturan QRIS Statis & Gateway Otomatis
          </h1>
          <p class="text-[11px] sm:text-xs text-slate-500 font-medium hidden sm:block truncate">
            Unggah gambar QRIS atau isi payload untuk konversi otomatis ke QRIS Dinamis
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <a href="/dashboard/finance" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold border border-slate-300 transition">
          <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
          <span>Kembali ke Ringkasan</span>
        </a>
      </div>
    </header>

    <div class="p-4 sm:p-6 max-w-7xl w-full mx-auto space-y-6">
      <!-- Flash Alert -->
      <% if (locals.success) { %>
        <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-3.5 flex items-center justify-between text-emerald-800 text-xs font-medium shadow-sm">
          <div class="flex items-center gap-2">
            <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
            <span><%= success %></span>
          </div>
        </div>
      <% } %>

      <% if (locals.error) { %>
        <div class="bg-rose-50 border border-rose-200 rounded-xl p-3.5 flex items-center justify-between text-rose-800 text-xs font-medium shadow-sm">
          <div class="flex items-center gap-2">
            <i data-lucide="alert-circle" class="w-4 h-4 text-rose-600"></i>
            <span><%= error %></span>
          </div>
        </div>
      <% } %>

      <!-- Grid 2 Kolom -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Kolom 1: Form Pengaturan QRIS Statis & Upload Gambar -->
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="qr-code" class="w-4 h-4 text-blue-600"></i>
              <span>Konfigurasi & Unggah Gambar QRIS</span>
            </h3>
            <span class="text-[11px] px-2 py-0.5 rounded-full font-semibold <%= qrisEnabled === '1' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
              <%= qrisEnabled === '1' ? 'Aktif' : 'Non-Aktif' %>
            </span>
          </div>

          <!-- Section Upload Gambar Barcode QRIS -->
          <div class="space-y-2">
            <label class="block text-xs font-bold text-slate-700">
              Unggah Foto / Gambar Barcode QRIS Sekolah
              <span class="text-[10px] text-slate-400 font-normal block">
                Pilih atau seret gambar QRIS statis (dari cetakan stiker BCA, Dana, Gopay, Bank). Sistem akan otomatis membaca barcode dan mengekstrak kode string payload EMVCo!
              </span>
            </label>

            <!-- Dropzone & Preview Container -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <!-- Dropzone Area -->
              <div 
                id="qrisDropzone"
                onclick="document.getElementById('qrisFileInput').click()"
                class="sm:col-span-2 border-2 border-dashed border-slate-300 hover:border-blue-500 rounded-xl p-4 flex flex-col items-center justify-center text-center cursor-pointer bg-slate-50/70 hover:bg-blue-50/30 transition duration-200 group"
              >
                <input 
                  type="file" 
                  id="qrisFileInput" 
                  accept="image/png,image/jpeg,image/jpg,image/webp" 
                  class="hidden" 
                  onchange="handleQrisImageUpload(this)"
                >
                <div class="w-10 h-10 rounded-full bg-blue-100 group-hover:bg-blue-200 text-blue-600 flex items-center justify-center mb-2 transition">
                  <i data-lucide="upload-cloud" class="w-5 h-5"></i>
                </div>
                <p class="text-xs font-bold text-slate-800 group-hover:text-blue-600 transition">
                  Klik / Seret Gambar QRIS ke Sini
                </p>
                <p class="text-[10px] text-slate-400 mt-0.5">
                  Format: JPG, PNG, WEBP (Maksimal 10MB)
                </p>
              </div>

              <!-- Thumbnail Preview Box -->
              <div id="qrisThumbContainer" class="p-3 bg-slate-50 rounded-xl border border-slate-200 flex flex-col items-center justify-center text-center">
                <% if (locals.qrisImagePath) { %>
                  <img id="qrisThumbImg" src="<%= qrisImagePath %>" alt="QRIS Merchant" class="w-20 h-20 object-contain rounded-lg border border-slate-200 shadow-sm mb-1 bg-white p-1">
                  <span class="text-[10px] font-bold text-emerald-600 flex items-center gap-1">
                    <i data-lucide="check" class="w-3 h-3"></i> Tersimpan
                  </span>
                <% } else { %>
                  <div id="qrisThumbPlaceholder" class="text-center py-2 space-y-1">
                    <div class="w-10 h-10 rounded-lg bg-slate-200 text-slate-400 flex items-center justify-center mx-auto">
                      <i data-lucide="image" class="w-5 h-5"></i>
                    </div>
                    <p class="text-[10px] text-slate-400">Belum ada gambar</p>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Status Indicator Pemindaian QR -->
            <div id="qrisDecodeStatus" style="display: none;" class="p-3 rounded-xl border text-xs flex items-center justify-between shadow-sm transition-all duration-300">
              <div class="flex items-center gap-2">
                <span id="qrisStatusSpinner" class="hidden">
                  <i data-lucide="loader-2" class="w-4 h-4 animate-spin text-blue-600"></i>
                </span>
                <span id="qrisDecodeStatusText" class="font-medium"></span>
              </div>
              <button type="button" onclick="runQrisTest()" class="text-xs font-bold underline shrink-0 ml-2">
                Uji QR Dinamis
              </button>
            </div>
          </div>

          <form method="POST" action="/dashboard/finance/qris/save" class="space-y-4 pt-2">
            <input type="hidden" name="qris_image_path" id="qrisImagePathInput" value="<%= locals.qrisImagePath || '' %>">

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Nama Merchant / Sekolah di QRIS</label>
              <input type="text" id="merchantNameInput" name="qris_merchant_name" value="<%= merchantName %>" required placeholder="Contoh: SMK TELADAN JAKARTA" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 font-medium focus:ring-2 focus:ring-blue-500 focus:outline-none">
            </div>

            <div>
              <div class="flex items-center justify-between mb-1">
                <label class="block text-xs font-bold text-slate-700">
                  String Payload QRIS Statis Asal (EMVCo)
                </label>
                <button type="button" onclick="runQrisTest()" class="text-[11px] font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
                  <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-500"></i>
                  <span>Generate Dinamis</span>
                </button>
              </div>
              <textarea name="qris_static_payload" id="qrisPayloadInput" rows="4" placeholder="00020101021126590014ID.LINKAJA.WWW...6304E8A3" class="w-full text-[11px] font-mono border border-slate-300 rounded-lg p-2.5 bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none leading-relaxed select-all"><%= staticPayload %></textarea>
              <p class="text-[10px] text-slate-400 mt-0.5">Payload terisi otomatis saat foto barcode QRIS diunggah di atas, atau dapat disalin manual.</p>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">
                Webhook Secret Key
                <span class="text-[10px] text-slate-400 font-normal block">Token rahasia untuk memverifikasi request webhook dari MacroDroid / HP Gateway</span>
              </label>
              <input type="text" name="payment_gateway_secret" value="<%= webhookSecret %>" required class="w-full text-xs font-mono border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 focus:ring-2 focus:ring-blue-500 focus:outline-none">
            </div>

            <div class="flex items-center gap-2 pt-1">
              <input type="checkbox" id="qris_static_enabled" name="qris_static_enabled" value="1" <%= qrisEnabled === '1' ? 'checked' : '' %> class="rounded border-slate-300 text-blue-600 focus:ring-blue-500">
              <label for="qris_static_enabled" class="text-xs text-slate-700 font-semibold">Aktifkan Konversi QRIS Dinamis & Webhook Otomatis</label>
            </div>

            <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
              <button type="button" onclick="runQrisTest()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition flex items-center gap-1.5">
                <i data-lucide="play" class="w-3.5 h-3.5 text-blue-600"></i>
                <span>Uji Konversi Sekarang</span>
              </button>
              <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow-sm transition">
                Simpan Konfigurasi QRIS
              </button>
            </div>
          </form>
        </div>

        <!-- Kolom 2: Live Simulator & Tester Konversi Real-Time -->
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="zap" class="w-4 h-4 text-amber-500"></i>
              <span>Hasil Generate QRIS Dinamis Real-Time</span>
            </h3>
            <span class="text-[10px] text-slate-400 font-mono">EMVCo TLV Standard</span>
          </div>

          <p class="text-xs text-slate-500 leading-relaxed">
            Barcode QRIS Dinamis berikut dihasilkan secara otomatis dari payload statis di samping dengan menyisipkan nominal tepat (Tag 54) dan menghitung ulang CRC16 CCITT.
          </p>

          <div class="flex gap-2">
            <div class="relative flex-1">
              <span class="absolute left-3 top-2.5 text-xs text-slate-400 font-semibold">Rp</span>
              <input type="number" id="testAmount" value="150247" step="1" class="w-full text-xs font-mono font-bold border border-slate-300 rounded-lg pl-9 pr-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
            </div>
            <button type="button" onclick="runQrisTest()" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg transition shrink-0 flex items-center gap-1.5">
              <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
              <span>Regenerate</span>
            </button>
          </div>

          <!-- Kotak Hasil Generate -->
          <div id="testResult" class="space-y-3 pt-2">
            <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl flex flex-col sm:flex-row items-center gap-4">
              <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-sm shrink-0">
                <img id="testQrImg" src="" alt="Dynamic QR" class="w-40 h-40 object-contain">
              </div>
              <div class="text-xs space-y-2 overflow-hidden w-full">
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="font-bold text-emerald-700 text-xs">QRIS Dinamis Siap Scan</span>
                </div>
                <div class="p-2.5 bg-white rounded-lg border border-slate-200 space-y-1 text-[11px]">
                  <div class="flex justify-between">
                    <span class="text-slate-500">Metode Tag 01:</span>
                    <span class="font-mono font-bold text-blue-600">12 (Dynamic)</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-slate-500">Nominal Tag 54:</span>
                    <span class="font-mono font-bold text-emerald-600" id="testDisplayAmount">-</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-slate-500">Merchant Name:</span>
                    <span class="font-bold text-slate-800 truncate" id="testMerchantNameDisplay">-</span>
                  </div>
                </div>
                <div>
                  <span class="text-[9px] text-slate-400 font-mono block mb-1">Payload Dinamis Lengkap:</span>
                  <div id="testPayloadOut" class="text-[10px] font-mono bg-white p-2 rounded border border-slate-200 max-h-16 overflow-y-auto break-all select-all text-slate-700"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Panduan Integrasi MacroDroid / HP Gateway -->
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <i data-lucide="smartphone" class="w-4 h-4 text-emerald-600"></i>
            <span>Panduan Forwarder Webhook Notifikasi (MacroDroid / SMS Forwarder)</span>
          </h3>
          <span class="text-xs text-blue-600 font-mono">POST /api/webhook/payment-notif</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-slate-600">
          <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <h4 class="font-bold text-slate-900 flex items-center gap-1.5">
              <span class="w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px]">1</span>
              <span>Trigger di MacroDroid</span>
            </h4>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              Pasang MacroDroid pada HP Bendahara/Sekolah yang menerima SMS atau Notifikasi Bank (BCA, Mandiri, BRI, Dana, Gopay, ShopeePay). Pasang Trigger: <b>Notification Received</b> dari aplikasi terkait.
            </p>
          </div>

          <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <h4 class="font-bold text-slate-900 flex items-center gap-1.5">
              <span class="w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px]">2</span>
              <span>Action: HTTP Request</span>
            </h4>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              Pilih Action <b>HTTP Request</b> dengan metode <b>POST</b> ke URL:
              <br><code class="text-[10px] text-blue-700 font-mono font-bold break-all">http://&lt;IP_SERVER&gt;:3000/api/webhook/payment-notif</code>
              <br>Header: <code class="text-[10px] font-mono">Content-Type: application/json</code>
            </p>
          </div>

          <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
            <h4 class="font-bold text-slate-900 flex items-center gap-1.5">
              <span class="w-5 h-5 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px]">3</span>
              <span>JSON Body Payload</span>
            </h4>
            <pre class="bg-slate-900 text-slate-100 p-2.5 rounded-lg text-[10px] font-mono overflow-x-auto leading-tight">{
  "service": "[notification_app_name]",
  "title": "[notification_title]",
  "content": "[notification_text]",
  "secret_key": "<%= webhookSecret %>"
}</pre>
          </div>
        </div>
      </div>

      <!-- Log Webhook Terakhir -->
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <i data-lucide="activity" class="w-4 h-4 text-blue-600"></i>
            <span>Log Request Webhook Terakhir</span>
          </h3>
          <span class="text-[11px] text-slate-400">Menampilkan 10 data terakhir</span>
        </div>

        <% if (logs.length === 0) { %>
          <div class="text-center py-8 text-slate-400">
            <p class="text-xs">Belum ada request webhook yang masuk.</p>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 text-slate-600 uppercase text-[10px] tracking-wider border-b border-slate-200">
                <tr>
                  <th class="py-2.5 px-3">Waktu</th>
                  <th class="py-2.5 px-3">Aplikasi/Provider</th>
                  <th class="py-2.5 px-3">Nominal Terdeteksi</th>
                  <th class="py-2.5 px-3">Status</th>
                  <th class="py-2.5 px-3">IP Pengirim</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 font-mono text-[11px]">
                <% logs.forEach(l => { %>
                  <tr>
                    <td class="py-2.5 px-3 text-slate-500 font-sans">
                      <%= new Date(l.created_at).toLocaleString('id-ID') %>
                    </td>
                    <td class="py-2.5 px-3 font-bold text-slate-900 font-sans">
                      <%= l.provider %>
                    </td>
                    <td class="py-2.5 px-3 text-emerald-600 font-bold">
                      <%= l.ref_id !== 'NO_AMOUNT' ? 'Rp ' + Number(l.ref_id).toLocaleString('id-ID') : '-' %>
                    </td>
                    <td class="py-2.5 px-3">
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= l.status === 'amount_parsed' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600' %>">
                        <%= l.status %>
                      </span>
                    </td>
                    <td class="py-2.5 px-3 text-slate-400">
                      <%= l.ip || '-' %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<script>
  // Drag and Drop listeners
  const dropzone = document.getElementById('qrisDropzone');
  if (dropzone) {
    ['dragenter', 'dragover'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('border-blue-600', 'bg-blue-50/50');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropzone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('border-blue-600', 'bg-blue-50/50');
      }, false);
    });

    dropzone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      const files = dt.files;
      if (files && files.length > 0) {
        const input = document.getElementById('qrisFileInput');
        input.files = files;
        handleQrisImageUpload(input);
      }
    }, false);
  }

  // Handle Client-side QRIS Image Upload & EMVCo Decoding
  async function handleQrisImageUpload(input) {
    if (!input.files || !input.files[0]) return;
    const file = input.files[0];

    const statusBox = document.getElementById('qrisDecodeStatus');
    const statusText = document.getElementById('qrisDecodeStatusText');
    const statusSpinner = document.getElementById('qrisStatusSpinner');
    const thumbContainer = document.getElementById('qrisThumbContainer');

    statusBox.style.display = 'flex';
    statusBox.className = 'p-3 rounded-xl border border-blue-200 bg-blue-50 text-blue-800 text-xs flex items-center justify-between shadow-sm';
    statusSpinner.classList.remove('hidden');
    statusText.innerText = '🔍 Membaca & memindai barcode QRIS...';

    const reader = new FileReader();
    reader.onload = function(e) {
      const img = new Image();
      img.onload = async function() {
        // Decode dengan ukuran asli atau resolusi berskala jika foto kamera HP besar
        let decodedPayload = decodeQrFromImage(img);

        if (!decodedPayload) {
          decodedPayload = decodeQrFromImageResized(img, 1000);
        }
        if (!decodedPayload) {
          decodedPayload = decodeQrFromImageResized(img, 600);
        }

        statusSpinner.classList.add('hidden');

        if (decodedPayload) {
          document.getElementById('qrisPayloadInput').value = decodedPayload;

          // Ekstrak Nama Merchant jika ada di Tag 59 (format EMVCo: 59[length][value])
          try {
            const m = decodedPayload.match(/59(\d{2})(.+?)(60\d{2}|61\d{2}|62\d{2}|6304)/);
            if (m && m[2]) {
              const len = parseInt(m[1], 10);
              const merchant = m[2].slice(0, len).trim();
              if (merchant) {
                document.getElementById('merchantNameInput').value = merchant;
              }
            }
          } catch (_) {}

          statusBox.className = 'p-3 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-800 text-xs flex items-center justify-between shadow-sm';
          statusText.innerHTML = '✅ <b>Barcode QRIS Valid!</b> String payload berhasil diekstrak & di-generate.';

          // Update Preview Thumbnail
          thumbContainer.innerHTML = `
            <img src="${e.target.result}" alt="QRIS Merchant" class="w-20 h-20 object-contain rounded-lg border border-slate-200 shadow-sm mb-1 bg-white p-1" />
            <span class="text-[10px] font-bold text-emerald-600">QR Terdeteksi</span>
          `;

          // Unggah ke server di latar belakang untuk persistensi file
          uploadQrisImageToServer(file);

          // Langsung jalankan pengujian & preview dinamis
          setTimeout(() => runQrisTest(), 200);

        } else {
          statusBox.className = 'p-3 rounded-xl border border-amber-200 bg-amber-50 text-amber-800 text-xs flex items-center justify-between shadow-sm';
          statusText.innerText = '⚠️ Barcode QR tidak terbaca jelas. Pastikan foto tidak buram atau potong fokus pada kotak QR.';

          thumbContainer.innerHTML = `
            <img src="${e.target.result}" alt="QRIS Merchant" class="w-20 h-20 object-contain rounded-lg border border-amber-200 shadow-sm mb-1 bg-white p-1" />
            <span class="text-[10px] font-bold text-amber-600">Scan Ulang</span>
          `;
        }
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  function decodeQrFromImage(img) {
    if (typeof jsQR === 'undefined') return null;
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    canvas.width = img.width;
    canvas.height = img.height;
    ctx.drawImage(img, 0, 0, img.width, img.height);
    const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const code = jsQR(imageData.data, imageData.width, imageData.height, {
      inversionAttempts: 'attemptBoth'
    });
    return code ? code.data : null;
  }

  function decodeQrFromImageResized(img, maxDimension) {
    if (typeof jsQR === 'undefined') return null;
    let width = img.width;
    let height = img.height;
    if (width > maxDimension || height > maxDimension) {
      if (width > height) {
        height = Math.round((height * maxDimension) / width);
        width = maxDimension;
      } else {
        width = Math.round((width * maxDimension) / height);
        height = maxDimension;
      }
    }
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    canvas.width = width;
    canvas.height = height;
    ctx.drawImage(img, 0, 0, width, height);
    const imageData = ctx.getImageData(0, 0, width, height);
    const code = jsQR(imageData.data, imageData.width, imageData.height, {
      inversionAttempts: 'attemptBoth'
    });
    return code ? code.data : null;
  }

  async function uploadQrisImageToServer(file) {
    try {
      const formData = new FormData();
      formData.append('qris_image', file);

      const res = await fetch('/dashboard/finance/qris/upload', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: formData
      });

      const data = await res.json();
      if (data.success && data.filePath) {
        document.getElementById('qrisImagePathInput').value = data.filePath;
      }
    } catch (e) {
      console.warn('[QRIS Upload] Notice:', e.message);
    }
  }

  async function runQrisTest() {
    const payload = document.getElementById('qrisPayloadInput').value.trim();
    const amount = document.getElementById('testAmount').value;
    const merchantName = document.getElementById('merchantNameInput').value;

    if (!payload) {
      alert('Isi string payload QRIS atau unggah foto barcode QRIS terlebih dahulu.');
      return;
    }

    try {
      const res = await fetch('/dashboard/finance/qris/test-convert', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ payload, amount })
      });
      const data = await res.json();

      if (!data.success) {
        alert(data.error || 'Gagal melakukan konversi QRIS');
        return;
      }

      document.getElementById('testQrImg').src = data.dataUrl;
      document.getElementById('testDisplayAmount').textContent = 'Rp ' + Number(amount).toLocaleString('id-ID');
      document.getElementById('testMerchantNameDisplay').textContent = merchantName || 'Merchant Sekolah';
      document.getElementById('testPayloadOut').textContent = data.dynamicPayload;
      document.getElementById('testResult').classList.remove('hidden');
    } catch (err) {
      alert('Error saat generate QRIS: ' + err.message);
    }
  }

  // Jalankan generate preview awal jika sudah ada payload
  window.addEventListener('DOMContentLoaded', () => {
    const initialPayload = document.getElementById('qrisPayloadInput')?.value?.trim();
    if (initialPayload) {
      runQrisTest();
    }
  });
</script>


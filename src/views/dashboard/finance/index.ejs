<%- include('../../partials/header', { title: pageTitle, isDashboard: true }) %>

<div class="flex h-screen overflow-hidden bg-slate-50">
  <%- include('../sidebar') %>

  <main class="flex-1 flex flex-col min-w-0 h-full overflow-y-auto">
    <!-- Header Navbar -->
    <header class="h-16 bg-white border-b border-slate-200 px-3.5 sm:px-6 flex items-center justify-between sticky top-0 z-20">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <button type="button" onclick="toggleSidebar()" class="md:hidden p-2 -ml-1 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition shrink-0">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <div class="min-w-0">
          <h1 class="text-sm sm:text-lg font-extrabold text-slate-900 leading-tight truncate">
            Keuangan & SPP Sekolah
          </h1>
          <p class="text-[11px] sm:text-xs text-slate-500 font-medium hidden sm:block truncate">
            Pantau arus kas, tagihan SPP, pelunasan QRIS Dinamis & pembayaran tunai
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <form method="GET" action="/dashboard/finance" class="flex items-center gap-2">
          <input type="month" name="month" value="<%= selectedMonth %>" onchange="this.form.submit()" class="text-xs bg-slate-100 border border-slate-300 rounded-lg px-2.5 py-1.5 font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
        </form>
        <a href="/dashboard/finance/bills?manage_categories=1" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold border border-indigo-200 transition">
          <i data-lucide="tags" class="w-3.5 h-3.5"></i>
          <span class="hidden sm:inline">Kelola Kategori</span>
        </a>
        <a href="/dashboard/finance/bills" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700 text-xs font-semibold shadow-sm transition">
          <i data-lucide="receipt" class="w-3.5 h-3.5"></i>
          <span class="hidden sm:inline">Kelola Tagihan</span>
        </a>
      </div>
    </header>

    <div class="p-4 sm:p-6 max-w-7xl w-full mx-auto space-y-6">
      <!-- Flash Alert -->
      <% if (locals.success) { %>
        <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-3.5 flex items-center justify-between text-emerald-800 text-xs font-medium shadow-sm">
          <div class="flex items-center gap-2">
            <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
            <span><%= success %></span>
          </div>
        </div>
      <% } %>

      <!-- Top Metric Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Pendapatan Bulan Ini -->
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500">Pemasukan (<%= selectedMonth %>)</span>
            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
              <i data-lucide="trending-up" class="w-4 h-4"></i>
            </div>
          </div>
          <div class="mt-2">
            <p class="text-xl font-bold text-slate-900"><%= formatRupiah(stats.totalIncome) %></p>
            <p class="text-[11px] text-emerald-600 font-medium mt-0.5">Dari <%= stats.paidCount %> tagihan lunas</p>
          </div>
        </div>

        <!-- Tagihan Menunggu Pembayaran -->
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500">Belum Lunas (Unpaid)</span>
            <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
              <i data-lucide="clock" class="w-4 h-4"></i>
            </div>
          </div>
          <div class="mt-2">
            <p class="text-xl font-bold text-slate-900"><%= formatRupiah(stats.pendingTotal) %></p>
            <p class="text-[11px] text-amber-600 font-medium mt-0.5"><%= stats.pendingCount %> tagihan menunggu bayar</p>
          </div>
        </div>

        <!-- Kategori Tagihan Aktif -->
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500">Kategori Biaya</span>
            <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <i data-lucide="layers" class="w-4 h-4"></i>
            </div>
          </div>
          <div class="mt-2">
            <p class="text-xl font-bold text-slate-900"><%= categories.length %></p>
            <p class="text-[11px] text-blue-600 font-medium mt-0.5">SPP, Gedung, Ujian, dll</p>
          </div>
        </div>

        <!-- Quick Action Card -->
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex flex-col justify-between">
          <span class="text-xs font-semibold text-slate-500">Aksi Cepat</span>
          <div class="flex items-center gap-2 mt-2">
            <button type="button" onclick="openCategoryModal()" class="flex-1 px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition text-center">
              + Kategori
            </button>
            <a href="/dashboard/finance/qris" class="flex-1 px-2.5 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold rounded-lg transition text-center">
              Setting QRIS
            </a>
          </div>
        </div>
      </div>

      <!-- Grid 2 Kolom: Kategori & Transaksi Terakhir -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Kolom Kiri: Breakdown per Kategori -->
        <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="pie-chart" class="w-4 h-4 text-blue-600"></i>
              <span>Pemasukan per Kategori</span>
            </h3>
            <span class="text-xs text-slate-400 font-medium"><%= selectedMonth %></span>
          </div>

          <% if (stats.categoryBreakdown.length === 0) { %>
            <div class="text-center py-8 text-slate-400">
              <i data-lucide="inbox" class="w-8 h-8 mx-auto stroke-1 mb-2 text-slate-300"></i>
              <p class="text-xs">Belum ada transaksi pembayaran pada bulan ini.</p>
            </div>
          <% } else { %>
            <div class="space-y-3">
              <% stats.categoryBreakdown.forEach(cat => { %>
                <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50 border border-slate-100">
                  <div>
                    <p class="text-xs font-bold text-slate-800"><%= cat.name %></p>
                    <p class="text-[10px] text-slate-500"><%= cat.bills_count %> transaksi</p>
                  </div>
                  <span class="text-xs font-bold text-emerald-600 font-mono">
                    <%= formatRupiah(cat.total_amount) %>
                  </span>
                </div>
              <% }) %>
            </div>
          <% } %>

          <div class="pt-2 border-t border-slate-100">
            <h4 class="text-xs font-bold text-slate-700 mb-2">Daftar Tarif Standar</h4>
            <div class="space-y-1.5 max-h-48 overflow-y-auto">
              <% categories.forEach(c => { %>
                <div class="flex items-center justify-between text-xs py-1 px-2 hover:bg-slate-50 rounded">
                  <span class="text-slate-600 truncate"><%= c.name %></span>
                  <span class="font-mono text-slate-700 font-semibold shrink-0"><%= formatRupiah(c.default_amount) %></span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: 10 Transaksi Pembayaran Terakhir -->
        <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="clock" class="w-4 h-4 text-blue-600"></i>
              <span>Riwayat Pelunasan Terakhir</span>
            </h3>
            <a href="/dashboard/finance/bills?status=PAID" class="text-xs font-semibold text-blue-600 hover:text-blue-700">
              Lihat Semua
            </a>
          </div>

          <% if (stats.recentPayments.length === 0) { %>
            <div class="text-center py-12 text-slate-400">
              <i data-lucide="receipt" class="w-10 h-10 mx-auto stroke-1 mb-2 text-slate-300"></i>
              <p class="text-xs">Belum ada transaksi pembayaran yang tercatat.</p>
            </div>
          <% } else { %>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-600 uppercase text-[10px] tracking-wider border-b border-slate-200">
                  <tr>
                    <th class="py-2.5 px-3">No. Kuitansi</th>
                    <th class="py-2.5 px-3">Siswa & Kelas</th>
                    <th class="py-2.5 px-3">Tagihan</th>
                    <th class="py-2.5 px-3 text-right">Nominal</th>
                    <th class="py-2.5 px-3 text-center">Metode</th>
                    <th class="py-2.5 px-3 text-center">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                  <% stats.recentPayments.forEach(p => { %>
                    <tr class="hover:bg-slate-50/70 transition">
                      <td class="py-2.5 px-3 font-mono font-semibold text-blue-600">
                        <%= p.receipt_no %>
                        <div class="text-[10px] text-slate-400 font-normal">
                          <%= new Date(p.created_at).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) %>
                        </div>
                      </td>
                      <td class="py-2.5 px-3">
                        <span class="font-bold text-slate-900"><%= p.student_name %></span>
                        <div class="text-[10px] text-slate-500"><%= p.class_name || '-' %></div>
                      </td>
                      <td class="py-2.5 px-3 truncate max-w-[140px]">
                        <%= p.title %>
                      </td>
                      <td class="py-2.5 px-3 text-right font-mono font-bold text-emerald-600">
                        <%= formatRupiah(p.amount_paid) %>
                      </td>
                      <td class="py-2.5 px-3 text-center">
                        <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold <%= p.payment_method === 'QRIS' ? 'bg-indigo-100 text-indigo-700' : 'bg-emerald-100 text-emerald-700' %>">
                          <%= p.payment_method %>
                        </span>
                      </td>
                      <td class="py-2.5 px-3 text-center">
                        <a href="/dashboard/finance/bills/<%= p.bill_id %>/receipt" target="_blank" class="p-1 text-slate-500 hover:text-blue-600 inline-block" title="Cetak Kuitansi">
                          <i data-lucide="printer" class="w-3.5 h-3.5"></i>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Modal Tambah / Edit Kategori Biaya -->
<div id="categoryModal" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="text-sm font-bold text-slate-900">Kelola Kategori Tagihan</h3>
      <button type="button" onclick="closeCategoryModal()" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form method="POST" action="/dashboard/finance/categories/save" class="space-y-3.5">
      <input type="hidden" id="catId" name="id" value="">
      
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Kode Unik Kategori (Huruf Kapital)</label>
        <input type="text" id="catCode" name="code" required placeholder="CONTOH: SPP, GEDUNG, PRAKTIK" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 uppercase font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Kategori Biaya</label>
        <input type="text" id="catName" name="name" required placeholder="Contoh: SPP Bulanan" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Tarif Standar (Rp)</label>
        <input type="number" id="catDefaultAmount" name="default_amount" required placeholder="150000" min="0" step="1000" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 font-mono focus:ring-2 focus:ring-blue-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Tipe Frekuensi Tagihan</label>
        <select id="catFrequency" name="frequency" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none font-medium bg-white">
          <option value="MONTHLY">📅 Bulanan (Tagihan rutin per bulan, misal: SPP)</option>
          <option value="WEEKLY">📆 Mingguan (Tagihan rutin per pekan, misal: Uang Kas, Infaq)</option>
          <option value="ONCE">🏷️ Sekali Bayar (Non-rutin, misal: Uang Gedung, Seragam)</option>
        </select>
      </div>

      <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
        <button type="button" onclick="closeCategoryModal()" class="px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100 rounded-lg font-semibold">Batal</button>
        <button type="submit" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow-sm">Simpan Kategori</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openCategoryModal() {
    document.getElementById('catId').value = '';
    document.getElementById('catCode').value = '';
    document.getElementById('catName').value = '';
    document.getElementById('catDefaultAmount').value = '';
    const freqEl = document.getElementById('catFrequency');
    if (freqEl) freqEl.value = 'MONTHLY';
    document.getElementById('categoryModal').classList.remove('hidden');
  }

  function closeCategoryModal() {
    document.getElementById('categoryModal').classList.add('hidden');
  }
</script>

<%- include('../../partials/footer') %>

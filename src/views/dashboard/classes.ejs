<%- include('../partials/header', { title: 'Manajemen Data Kelas', isDashboard: true }) %>

<div class="flex h-screen overflow-hidden bg-slate-50">
  <%- include('sidebar') %>

  <main class="flex-1 flex flex-col min-w-0 h-full overflow-y-auto">
    <!-- Header -->
    <header class="h-16 bg-white border-b border-slate-200 px-3.5 sm:px-6 flex items-center justify-between sticky top-0 z-20">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <button type="button" onclick="toggleSidebar()" class="md:hidden p-2 -ml-1 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition shrink-0" title="Buka Menu">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <div class="min-w-0">
          <h1 class="text-sm sm:text-lg font-extrabold text-slate-900 leading-tight truncate">Data Kelas</h1>
          <p class="text-[11px] sm:text-xs text-slate-500 font-medium hidden sm:block truncate">Pengelompokan rombongan belajar dan cetak kartu pelajar</p>
        </div>
      </div>

      <% if (currentUser.role === 'admin') { %>
        <button onclick="openModal('addClassModal')" class="inline-flex items-center justify-center p-2 sm:px-3 sm:py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-sm transition shrink-0" title="Tambah Kelas Baru">
          <i data-lucide="plus" class="w-4 h-4 sm:w-3.5 sm:h-3.5"></i>
          <span class="hidden sm:inline sm:ml-1.5">Tambah Kelas</span>
        </button>
      <% } %>
    </header>

    <div class="p-4 sm:p-6 space-y-4 max-w-5xl">
      <% if (successMsg) { %>
        <div class="flash-alert bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium p-3.5 rounded-xl flex items-center justify-between gap-2 shadow-sm transition-all duration-500">
          <div class="flex items-center gap-2">
            <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600 flex-shrink-0"></i>
            <span><%= successMsg %></span>
          </div>
          <button type="button" onclick="dismissAlert(this.closest('.flash-alert'))" class="text-emerald-600 hover:text-emerald-900 p-1 rounded-lg hover:bg-emerald-100 transition shrink-0" title="Tutup Notifikasi">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      <% } %>
      <% if (errorMsg) { %>
        <div class="flash-alert bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium p-3.5 rounded-xl flex items-center justify-between gap-2 shadow-sm transition-all duration-500">
          <div class="flex items-center gap-2">
            <i data-lucide="alert-circle" class="w-4 h-4 text-rose-600 flex-shrink-0"></i>
            <span><%= errorMsg %></span>
          </div>
          <button type="button" onclick="dismissAlert(this.closest('.flash-alert'))" class="text-rose-600 hover:text-rose-900 p-1 rounded-lg hover:bg-rose-100 transition shrink-0" title="Tutup Notifikasi">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      <% } %>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200">
              <th class="px-6 py-3">Nama Kelas</th>
              <th class="px-6 py-3">Tingkat / Jenjang</th>
              <th class="px-6 py-3">Jumlah Siswa</th>
              <th class="px-6 py-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% classes.forEach(c => { %>
              <tr class="hover:bg-slate-50/50 transition">
                <td class="px-6 py-4 font-bold text-slate-900 text-sm">
                  <%= c.name %>
                </td>
                <td class="px-6 py-4 text-slate-500">
                  Tingkat <%= c.level || '-' %>
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                    <i data-lucide="users" class="w-3 h-3"></i> <%= c.student_count %> Siswa
                  </span>
                </td>
                <td class="px-6 py-4 text-right space-x-2">
                  <!-- Cetak Kartu Siswa Satu Kelas -->
                  <a href="/dashboard/classes/<%= c.id %>/cards" target="_blank" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 font-semibold transition" title="Cetak Semua Kartu Pelajar Kelas Ini">
                    <i data-lucide="printer" class="w-3.5 h-3.5"></i>
                    <span>Cetak Kartu (<%= c.student_count %>)</span>
                  </a>

                  <% if (currentUser.role === 'admin') { %>
                    <button onclick="openEditClassModal(<%= c.id %>, '<%= c.name %>', '<%= c.level || '' %>')" class="p-1.5 rounded-md hover:bg-blue-50 text-blue-600 transition" title="Edit">
                      <i data-lucide="edit-2" class="w-3.5 h-3.5"></i>
                    </button>

                    <form action="/dashboard/classes/<%= c.id %>/delete" method="POST" class="inline-block" onsubmit="return confirm('Hapus kelas <%= c.name %>?')">
                      <button type="submit" class="p-1.5 rounded-md hover:bg-rose-50 text-rose-600 transition" title="Hapus">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<!-- Modal Tambah Kelas -->
<div id="addClassModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
  <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <h3 class="font-bold text-slate-900 text-sm">Tambah Kelas Baru</h3>
      <button onclick="closeModal('addClassModal')" class="text-slate-400 hover:text-slate-600">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form action="/dashboard/classes" method="POST" class="mt-4 space-y-3 text-xs">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Nama Kelas *</label>
        <input type="text" name="name" required placeholder="Contoh: X IPA 3" class="w-full p-2 bg-slate-50 border border-slate-200 rounded-lg">
      </div>
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Tingkat / Jenjang</label>
        <input type="text" name="level" placeholder="Contoh: 10" class="w-full p-2 bg-slate-50 border border-slate-200 rounded-lg">
      </div>
      <div class="pt-3 flex justify-end gap-2">
        <button type="button" onclick="closeModal('addClassModal')" class="px-4 py-2 bg-slate-100 text-slate-700 rounded-lg font-semibold">Batal</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold">Simpan Kelas</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit Kelas -->
<div id="editClassModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
  <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <h3 class="font-bold text-slate-900 text-sm">Edit Data Kelas</h3>
      <button onclick="closeModal('editClassModal')" class="text-slate-400 hover:text-slate-600">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form id="editClassForm" method="POST" class="mt-4 space-y-3 text-xs">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Nama Kelas *</label>
        <input type="text" id="edit_class_name" name="name" required class="w-full p-2 bg-slate-50 border border-slate-200 rounded-lg">
      </div>
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Tingkat / Jenjang</label>
        <input type="text" id="edit_class_level" name="level" class="w-full p-2 bg-slate-50 border border-slate-200 rounded-lg">
      </div>
      <div class="pt-3 flex justify-end gap-2">
        <button type="button" onclick="closeModal('editClassModal')" class="px-4 py-2 bg-slate-100 text-slate-700 rounded-lg font-semibold">Batal</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold">Perbarui</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openModal(id) {
    const m = document.getElementById(id);
    m.classList.remove('hidden');
    m.classList.add('flex');
  }

  function closeModal(id) {
    const m = document.getElementById(id);
    m.classList.add('hidden');
    m.classList.remove('flex');
  }

  function openEditClassModal(id, name, level) {
    document.getElementById('editClassForm').action = `/dashboard/classes/${id}/edit`;
    document.getElementById('edit_class_name').value = name;
    document.getElementById('edit_class_level').value = level;
    openModal('editClassModal');
  }
</script>

<%- include('../partials/footer', { isDashboard: true }) %>

<%- include('../partials/header', { title: 'Manajemen WhatsApp Gateway Baileys', isDashboard: true }) %>

<div class="flex h-screen overflow-hidden bg-slate-50">
  <%- include('sidebar') %>

  <main class="flex-1 flex flex-col min-w-0 h-full overflow-y-auto">
    <!-- Header -->
    <header class="h-16 bg-white border-b border-slate-200 px-3.5 sm:px-6 flex items-center justify-between sticky top-0 z-20">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <button type="button" onclick="toggleSidebar()" class="md:hidden p-2 -ml-1 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition shrink-0" title="Buka Menu">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <div class="min-w-0">
          <h1 class="text-sm sm:text-lg font-extrabold text-slate-900 leading-tight truncate">WhatsApp Gateway</h1>
          <p class="text-[11px] sm:text-xs text-slate-500 font-medium hidden sm:block truncate">Status sesi bot WhatsApp, antrean pesan, dan verifikasi nomor 2-arah</p>
        </div>
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <form action="/dashboard/whatsapp/reconnect" method="POST" class="inline-block">
          <button type="submit" class="inline-flex items-center justify-center p-2 sm:px-3 sm:py-1.5 rounded-lg bg-blue-50 border border-blue-200 text-blue-700 hover:bg-blue-100 text-xs font-semibold transition" title="Mulai Ulang Koneksi WhatsApp">
            <i data-lucide="refresh-cw" class="w-4 h-4 sm:w-3.5 sm:h-3.5"></i>
            <span class="hidden sm:inline sm:ml-1.5">Mulai Ulang</span>
          </button>
        </form>

        <form action="/dashboard/whatsapp/logout" method="POST" class="inline-block" onsubmit="return confirm('Keluar dari sesi WhatsApp? Anda perlu scan QR lagi.')">
          <button type="submit" class="inline-flex items-center justify-center p-2 sm:px-3 sm:py-1.5 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 hover:bg-rose-100 text-xs font-semibold transition" title="Logout Sesi WhatsApp">
            <i data-lucide="log-out" class="w-4 h-4 sm:w-3.5 sm:h-3.5"></i>
            <span class="hidden sm:inline sm:ml-1.5">Logout Sesi</span>
          </button>
        </form>
      </div>
    </header>

    <div class="p-4 sm:p-6 space-y-4 sm:space-y-6 max-w-7xl">
      <% if (successMsg) { %>
        <div class="flash-alert bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium p-3.5 rounded-xl flex items-center justify-between gap-2 shadow-sm transition-all duration-500">
          <div class="flex items-center gap-2">
            <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600 flex-shrink-0"></i>
            <span><%= successMsg %></span>
          </div>
          <button type="button" onclick="dismissAlert(this.closest('.flash-alert'))" class="text-emerald-600 hover:text-emerald-900 p-1 rounded-lg hover:bg-emerald-100 transition shrink-0" title="Tutup Notifikasi">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      <% } %>
      <% if (errorMsg) { %>
        <div class="flash-alert bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium p-3.5 rounded-xl flex items-center justify-between gap-2 shadow-sm transition-all duration-500">
          <div class="flex items-center gap-2">
            <i data-lucide="alert-circle" class="w-4 h-4 text-rose-600 flex-shrink-0"></i>
            <span><%= errorMsg %></span>
          </div>
          <button type="button" onclick="dismissAlert(this.closest('.flash-alert'))" class="text-rose-600 hover:text-rose-900 p-1 rounded-lg hover:bg-rose-100 transition shrink-0" title="Tutup Notifikasi">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      <% } %>

      <!-- Grid Status Koneksi & Uji Coba -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Card QR Code / Status Koneksi -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col items-center justify-center text-center">
          <div id="waStatusBadge" class="mb-4">
            <% if (statusInfo.status === 'connected') { %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> WhatsApp Terhubung
              </span>
            <% } else if (statusInfo.status === 'qr_ready') { %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span> Siap Scan QR
              </span>
            <% } else { %>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-300">
                <span class="w-2 h-2 rounded-full bg-slate-400"></span> Menghubungkan...
              </span>
            <% } %>
          </div>

          <!-- Container QR Image -->
          <div class="w-52 h-52 bg-slate-50 border border-slate-200 rounded-2xl flex items-center justify-center p-3 relative overflow-hidden mb-3">
            <img id="waQrImage" src="<%= statusInfo.qrCodeDataUrl || '' %>" alt="QR Code WhatsApp" class="w-full h-full object-contain <%= statusInfo.status === 'qr_ready' ? '' : 'hidden' %>">
            
            <div id="waConnectedPlaceholder" class="<%= statusInfo.status === 'connected' ? '' : 'hidden' %> text-emerald-600 flex flex-col items-center gap-2">
              <i data-lucide="check-circle-2" class="w-16 h-16 text-emerald-500"></i>
              <p class="text-xs font-bold text-slate-800">Sesi Aktif</p>
              <p class="font-mono text-[11px] text-slate-500 truncate max-w-[180px]"><%= statusInfo.userJid || '' %></p>
            </div>

            <div id="waLoadingPlaceholder" class="<%= (statusInfo.status !== 'connected' && statusInfo.status !== 'qr_ready') ? '' : 'hidden' %> text-slate-400 flex flex-col items-center gap-2">
              <i data-lucide="loader-2" class="w-10 h-10 text-slate-400 animate-spin"></i>
              <p class="text-xs">Menyiapkan QR Code...</p>
            </div>
          </div>

          <p class="text-xs text-slate-500 max-w-xs">
            Buka WhatsApp di ponsel &rarr; Ketuk Titik Tiga / Perangkat Tertaut &rarr; Tautkan Perangkat &rarr; Scan QR di atas.
          </p>
        </div>

        <!-- Card Uji Coba Kirim Pesan (Test Send) -->
        <div class="lg:col-span-2 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <h3 class="font-bold text-slate-900 text-sm mb-1 flex items-center gap-2">
              <i data-lucide="send" class="w-4 h-4 text-blue-600"></i>
              Uji Coba Kirim Pesan WhatsApp
            </h3>
            <p class="text-xs text-slate-500 mb-4">
              Kirim pesan percobaan ke nomor Anda untuk memastikan koneksi Baileys berfungsi dengan baik.
            </p>

            <form action="/dashboard/whatsapp/test" method="POST" class="space-y-3 text-xs">
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Nomor Tujuan WhatsApp (Contoh: 081234567890)</label>
                <input type="text" name="test_phone" required placeholder="081234567890" class="w-full p-2 bg-slate-50 border border-slate-200 rounded-lg font-mono">
              </div>
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Isi Pesan Uji Coba</label>
                <textarea name="test_message" rows="3" required class="w-full p-2 bg-slate-50 border border-slate-200 rounded-lg">Halo, ini adalah pesan uji coba dari sistem Absensi Sekolah WhatsApp Gateway Baileys.</textarea>
              </div>
              <div>
                <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-sm transition">
                  Kirim Pesan Percobaan
                </button>
              </div>
            </form>
          </div>

          <!-- Info Anti-Ban Baileys -->
          <div class="mt-6 pt-4 border-t border-slate-100 bg-emerald-50/50 p-3 rounded-xl border border-emerald-100 text-xs text-emerald-900 space-y-1">
            <p class="font-bold flex items-center gap-1.5 text-emerald-800">
              <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
              Perlindungan Anti-Ban Terpasang:
            </p>
            <p class="text-[11px] text-emerald-700 leading-relaxed">
              Pesan dikirim secara bertahap dengan jeda acak (1.5 - 3 detik). Selalu gunakan fitur <strong>"Kirim Pesan Pengenalan WA"</strong> di Data Siswa agar wali murid menyimpan kontak dan membalas <strong>"YA"</strong> sebelum broadcast massal.
            </p>
          </div>
        </div>
      </div>

      <!-- Ringkasan Antrean & Tombol Retry -->
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-6 text-xs">
          <div>
            <span class="text-slate-400 block text-[10px] uppercase font-bold">Pending</span>
            <span class="text-xl font-extrabold text-slate-800 font-mono"><%= stats.pending || 0 %></span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px] uppercase font-bold">Sedang Mengirim</span>
            <span class="text-xl font-extrabold text-blue-600 font-mono"><%= stats.sending || 0 %></span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px] uppercase font-bold">Terkirim</span>
            <span class="text-xl font-extrabold text-emerald-600 font-mono"><%= stats.sent || 0 %></span>
          </div>
          <div>
            <span class="text-slate-400 block text-[10px] uppercase font-bold">Gagal</span>
            <span class="text-xl font-extrabold text-rose-600 font-mono"><%= stats.failed || 0 %></span>
          </div>
        </div>

        <% if (stats.failed > 0) { %>
          <form action="/dashboard/whatsapp/retry-queue" method="POST">
            <button type="submit" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-semibold text-xs transition">
              <i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i>
              <span>Coba Lagi <%= stats.failed %> Pesan Gagal</span>
            </button>
          </form>
        <% } %>
      </div>

      <!-- Tabel 50 Log Antrean Terakhir -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
          <h3 class="font-bold text-slate-800 text-sm">Riwayat Antrean Pesan (50 Terakhir)</h3>
          <span class="text-xs text-slate-500 font-mono"><%= stats.total || 0 %> Total Antrean</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200">
                <th class="px-4 py-3">Waktu</th>
                <th class="px-4 py-3">Nomor Tujuan</th>
                <th class="px-4 py-3">Siswa</th>
                <th class="px-4 py-3">Tipe Pesan</th>
                <th class="px-4 py-3">Status</th>
                <th class="px-4 py-3">Keterangan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (queueLogs.length === 0) { %>
                <tr>
                  <td colspan="6" class="px-4 py-8 text-center text-slate-400">
                    Belum ada antrean pesan yang dicatat.
                  </td>
                </tr>
              <% } %>
              <% queueLogs.forEach(q => { %>
                <tr class="hover:bg-slate-50/50 transition">
                  <td class="px-4 py-3 text-slate-500 font-mono whitespace-nowrap">
                    <%= q.created_at %>
                  </td>
                  <td class="px-4 py-3 font-mono font-semibold text-slate-800 whitespace-nowrap">
                    <%= q.phone %>
                  </td>
                  <td class="px-4 py-3 text-slate-700 whitespace-nowrap">
                    <%= q.student_name ? q.student_name + ' (' + q.nis + ')' : '-' %>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700 font-mono">
                      <%= q.type || 'ATTENDANCE' %>
                    </span>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <% if (q.status === 'sent') { %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Sukses
                      </span>
                    <% } else if (q.status === 'sending') { %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span> Mengirim
                      </span>
                    <% } else if (q.status === 'failed') { %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        Gagal (<%= q.attempts %>x)
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        Pending
                      </span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-slate-500 text-[11px] max-w-xs truncate">
                    <%= q.error_message || q.message %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
  // Polling Status WhatsApp Realtime Setiap 3 Detik
  async function pollWaStatus() {
    try {
      const res = await fetch('/api/whatsapp/status');
      const data = await res.json();

      const qrImg = document.getElementById('waQrImage');
      const connPlaceholder = document.getElementById('waConnectedPlaceholder');
      const loadPlaceholder = document.getElementById('waLoadingPlaceholder');
      const statusBadge = document.getElementById('waStatusBadge');

      if (data.status === 'connected') {
        qrImg.classList.add('hidden');
        loadPlaceholder.classList.add('hidden');
        connPlaceholder.classList.remove('hidden');
        statusBadge.innerHTML = `
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> WhatsApp Terhubung
          </span>
        `;
      } else if (data.status === 'qr_ready' && data.qrCodeDataUrl) {
        connPlaceholder.classList.add('hidden');
        loadPlaceholder.classList.add('hidden');
        qrImg.src = data.qrCodeDataUrl;
        qrImg.classList.remove('hidden');
        statusBadge.innerHTML = `
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span> Siap Scan QR
          </span>
        `;
      } else {
        qrImg.classList.add('hidden');
        connPlaceholder.classList.add('hidden');
        loadPlaceholder.classList.remove('hidden');
      }
    } catch (e) {
      // Ignore polling network error
    }
  }

  setInterval(pollWaStatus, 3000);
</script>

<%- include('../partials/footer', { isDashboard: true }) %>

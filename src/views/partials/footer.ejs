  <% if (typeof isDashboard === 'undefined' || !isDashboard) { %>
  <footer class="bg-white border-t border-slate-200 mt-auto py-6 text-sm text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <% if (settings.school_logo) { %>
          <img src="<%= settings.school_logo %>" alt="Logo" class="w-7 h-7 object-contain rounded">
        <% } %>
        <p class="font-medium text-slate-700">
          <%= settings.school_name || 'Sistem Absensi Sekolah' %>
        </p>
      </div>
      <p class="text-xs text-slate-400">
        &copy; <%= new Date().getFullYear() %> <%= settings.school_name || 'Sistem Absensi Sekolah' %> &bull; Hak Cipta Dilindungi.
      </p>
    </div>
  </footer>
  <% } %>

  <script>
    // Inisialisasi ikon Lucide
    if (window.lucide) {
      lucide.createIcons();
    }

    // Fungsi tutup notifikasi alert secara interaktif & animasi halus
    function dismissAlert(alertEl) {
      if (!alertEl) return;
      alertEl.style.transition = 'all 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
      alertEl.style.opacity = '0';
      alertEl.style.transform = 'translateY(-10px)';
      setTimeout(() => {
        alertEl.style.maxHeight = '0';
        alertEl.style.paddingTop = '0';
        alertEl.style.paddingBottom = '0';
        alertEl.style.marginTop = '0';
        alertEl.style.marginBottom = '0';
        alertEl.style.borderWidth = '0';
        alertEl.style.overflow = 'hidden';
        setTimeout(() => alertEl.remove(), 400);
      }, 500);
    }

    // Otomatis hilangkan notif flash alert setelah 3.5 detik
    document.addEventListener('DOMContentLoaded', () => {
      const alerts = document.querySelectorAll('.flash-alert, [data-alert="flash"]');
      if (alerts.length > 0) {
        setTimeout(() => {
          alerts.forEach(alert => dismissAlert(alert));
        }, 3500);

        // Bersihkan parameter query (?success=... atau ?error=...) dari URL address bar
        if (window.location.search && (window.location.search.includes('success=') || window.location.search.includes('error='))) {
          const cleanUrl = window.location.pathname;
          window.history.replaceState({}, document.title, cleanUrl);
        }
      }
    });
  </script>
</body>
</html>

  <% if (typeof isDashboard === 'undefined' || !isDashboard) { %>
  <footer class="bg-white border-t border-slate-200 mt-auto py-6 text-sm text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <% if (settings.school_logo) { %>
          <img src="<%= settings.school_logo %>" alt="Logo" class="w-7 h-7 object-contain rounded">
        <% } %>
        <p class="font-medium text-slate-700">
          <%= settings.school_name || 'Sistem Absensi Sekolah' %>
        </p>
      </div>
      <p class="text-xs text-slate-400">
        &copy; <%= new Date().getFullYear() %> <%= settings.school_name || 'Sistem Absensi Sekolah' %> &bull; Hak Cipta Dilindungi.
      </p>
    </div>
  </footer>
  <% } %>

  <script>
    // Inisialisasi ikon Lucide
    if (window.lucide) {
      lucide.createIcons();
    }
  </script>
</body>
</html>
